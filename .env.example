# OCC — Claude Chain Orchestrator
# Copy this file to .env and adjust values

# ── Server ──────────────────────────────────────────
REST_PORT=4242
REST_HOST=0.0.0.0

# ── Paths ───────────────────────────────────────────
CHAINS_DIR=./chains
PIPELINES_DIR=./pipelines
WORKSPACE_DIR=.

# ── Execution ──────────────────────────────────────
CLAUDE_CLI=claude
CLAUDE_TIMEOUT_MS=300000
EXECUTION_MAX_AGE_DAYS=7

# ── Display ─────────────────────────────────────────
NO_COLOR=1
