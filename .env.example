# OCC — Claude Chain Orchestrator
# Copy this file to .env and adjust values

# ── Security ────────────────────────────────────────
# OCC_API_KEY=your-secret-key-here    # Set to enable API authentication (required for production)

# ── Server ──────────────────────────────────────────
REST_PORT=4242
REST_HOST=127.0.0.1                   # Default: localhost only. Set 0.0.0.0 for network access (behind reverse proxy)
# CORS_ORIGIN=https://yourdomain.com  # Default: http://localhost:8888

# ── Paths ───────────────────────────────────────────
CHAINS_DIR=./chains
PIPELINES_DIR=./pipelines
WORKSPACE_DIR=.

# ── Execution ──────────────────────────────────────
CLAUDE_CLI=claude
CLAUDE_TIMEOUT_MS=1800000
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_MAX_AGE_DAYS=7

# ── Storage (SQLite) ───────────────────────────────
# OCC_DB=./occ.db
# OCC_QUEUE_DB=./occ-queue.db
# OCC_STATE_DB=/tmp/occ-state.db
# OCC_VECTOR_DB=/tmp/occ-vectors.db
# OCC_SEMANTIC_CACHE_DB=/tmp/occ-semantic-cache.db
# OCC_GRAPH_DB=/tmp/occ-graph.db

# ── External MCP Servers ───────────────────────────
# MCP_SERVERS_CONFIG=./occ-mcp-servers.json

# ── Logging ─────────────────────────────────────────
# LOG_LEVEL=info                      # debug, info, warn, error
# LOG_FORMAT=text                     # text (colored) or json (structured)
# NO_COLOR=1                          # Disable ANSI colors

# ── BLOB Configuration ─────────────────────────────
# BLOB_DIR=./blobs
# BLOB_PLANNING_MODEL=claude-haiku-4-5
# BLOB_CHAT_MODEL=claude-sonnet-4-6
# BLOB_STEP_MODEL=claude-sonnet-4-6
# BLOB_AUTO_CHECK_SEC=60

# ── Rate Limiting ──────────────────────────────────
# RATE_LIMIT_EXEC=20                   # Max chain executions per minute
# RATE_LIMIT_GEN=5                     # Max chain generation requests per minute

# ── Email (Resend) ─────────────────────────────────
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=noreply@yourdomain.com

# ── Email (SendGrid — legacy) ─────────────────────
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM=noreply@example.com

# ── LLM Providers ─────────────────────────────────
# LLM_PROVIDERS_CONFIG=./llm-providers.json

# ── Frontend ──────────────────────────────────────
# FRONTEND_DIST=../frontend-react/dist
# CANVAS_DIST=../canvas/dist

# ── Advanced ───────────────────────────────────────
# PUBLIC_HOST=localhost
# SCHEDULES_FILE=../schedules.json
