# OCC — Claude Chain Orchestrator
# Copy this file to .env and adjust values

# ── Server ──────────────────────────────────────────
REST_PORT=4242
REST_HOST=0.0.0.0
# CORS_ORIGIN=https://yourdomain.com   # default: * (all origins)

# ── Paths ───────────────────────────────────────────
CHAINS_DIR=./chains
PIPELINES_DIR=./pipelines
WORKSPACE_DIR=.

# ── Execution ──────────────────────────────────────
CLAUDE_CLI=claude
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MS=300000
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_MAX_AGE_DAYS=7

# ── Storage (SQLite) ───────────────────────────────
# OCC_DB=./occ.db
# OCC_QUEUE_DB=./occ-queue.db
# EXECUTIONS_FILE=./executions.json
# SCHEDULES_FILE=./schedules.json

# ── External MCP Servers ───────────────────────────
# MCP_SERVERS_CONFIG=./occ-mcp-servers.json

# ── Display ─────────────────────────────────────────
NO_COLOR=1
